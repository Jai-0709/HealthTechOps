# HealthTechOps Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# Database
DATABASE_URL=postgresql+psycopg2://healthtechops:healthtechops@localhost:5432/healthtechops
# For local dev without Docker: sqlite+aiosqlite:///./healthtechops.db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Monitoring
MONITORING_INTERVAL_SECONDS=15
METRICS_PORT=9100

# Alert Thresholds
CPU_CRITICAL_THRESHOLD=95
CPU_HIGH_THRESHOLD=85
CPU_MEDIUM_THRESHOLD=75
MEMORY_CRITICAL_THRESHOLD=95
MEMORY_HIGH_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=90
DISK_HIGH_THRESHOLD=80
LATENCY_CRITICAL_MS=5000
LATENCY_HIGH_MS=2000
ERROR_RATE_CRITICAL=0.1
ERROR_RATE_HIGH=0.05

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=false

# Synthetic Services (ports)
CLAIMS_API_PORT=8010
PROVIDER_PORTAL_PORT=8011
PHARMACY_SERVICE_PORT=8012
IDENTITY_SERVICE_PORT=8013
NOTIFICATION_SERVICE_PORT=8014
DATABASE_SERVICE_PORT=8015

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
